rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own profile: wallet balance, points, display name.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Personal donation history — each contribution a user makes, kept
      // under their own profile so it's naturally scoped to owner-only
      // access without a separate uid field to check.
      match /contributions/{contributionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Ramadan Mode's fasting/tarawih tracker — one doc per Hijri year.
      match /ramadanTracker/{hijriYear} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Donation campaigns (e.g. "Listrik Masjid Al-Ikhlas") are public read
    // so the home feed works signed-out. Creating a campaign is admin-only
    // now — api/approve-masjid.js does it via the Admin SDK (which bypasses
    // these rules entirely), triggered from the Google Sheet review flow
    // (see CLAUDE.md's "Daftarkan Masjid" note) — so `create` is closed to
    // clients entirely. `update` stays open to any signed-in user, but only
    // for the `collected` field: that's the one write real donors make
    // (tapping +10rb/+25rb/+50rb in Donasi.jsx), everything else about a
    // campaign (title, target, deadline, ...) is set once at creation and
    // never edited by a client afterwards.
    match /donations/{id} {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collected']);
      allow create, delete: if false;
    }

    // Everything else stays locked until it has a real data model.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
