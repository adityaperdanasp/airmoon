{
  "hosting": {
    "public": "app/dist",
    "ignore": ["firebase.json", "**/.*", "!**/.well-known/**", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
