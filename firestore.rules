rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own profile: wallet balance, points, display name.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Personal donation history — each contribution a user makes, kept
      // under their own profile so it's naturally scoped to owner-only
      // access without a separate uid field to check.
      match /contributions/{contributionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Ramadan Mode's fasting/tarawih tracker — one doc per Hijri year.
      match /ramadanTracker/{hijriYear} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Favorit Ayat — one doc per saved ayat (id = "chapter:verse"),
      // separate from the single lastReadAyat/lastReadMushaf pointer on
      // the parent users/{uid} doc itself.
      match /favoriteAyat/{verseKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Amalan Harian — Home's unified daily checklist (sholat + tilawah;
      // Dzikir Pagi/Petang reuse dzikirStreak on the parent doc instead of
      // a doc here). One doc per day, id = "YYYY-MM-DD".
      match /amalanHarian/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Tabungan Umroh's deposit log — the goal itself (target/months/
      // startDate) lives as a plain field on the parent users/{uid} doc,
      // this is just the running history of each individual deposit.
      match /umrohDeposits/{depositId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Catatan Puasa Sunnah — one doc per fasted date, id = "YYYY-MM-DD".
      // Pairs with the existing push reminder in
      // check-campaign-deadlines.js (Senin/Kamis, Ayyamul Bidh), which
      // only ever nudged without a way to actually record the fast.
      match /puasaSunnah/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Checklist Sunnah Jumat (2026-09-12) — one doc per Friday date,
      // holding a map of which sunnah items (mandi/wangi/kuku/Al-Kahfi)
      // are done that day. Same owner-only, no-field-validation shape as
      // every other personal tracker under users/{uid}.
      match /jumatChecklist/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // In-app rating/feedback prompt — one doc per submission. Paired
      // with lib/ratingPrompt.js's timing logic (no Play Store/App Store
      // listing exists to link to yet, so this is the real feedback
      // channel instead of a fake "rate us" link).
      match /feedback/{feedbackId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Donation campaigns (e.g. "Listrik Masjid Al-Ikhlas") are public read
    // so the home feed works signed-out. Fully closed to client writes now
    // — creating one is admin-only (api/approve-masjid.js, via the Google
    // Sheet review flow) and `collected` only moves once a real Midtrans
    // payment is confirmed (api/midtrans-notify.js's signature-verified
    // webhook). Both write server-side via the Admin SDK, which bypasses
    // these rules entirely, so there's no client write case left to allow
    // — tapping +10rb/+25rb/+50rb used to `update` this doc's `collected`
    // field directly, back when that button just faked a donation; real
    // money now flows through Midtrans first.
    match /donations/{id} {
      allow read: if true;
      allow write: if false;

      // Wall of Gratitude (2026-09-12) — re-scoped from "masjid admin
      // posts a thank-you" (this app has no clean way to authenticate
      // "you're the admin of this specific masjid" — donations/{id} has
      // no owner uid) to a public testimoni wall: any signed-in user can
      // post a short note of thanks on a campaign that's actually funded
      // (request.resource.data still can't fake a fully-funded campaign
      // — the `get()` check reads the REAL donation doc). Same low-stakes
      // trust level as doas/featureRequests, no money involved here
      // either.
      match /gratitude/{gratitudeId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && get(/databases/$(database)/documents/donations/$(id)).data.collected
             >= get(/databases/$(database)/documents/donations/$(id)).data.target;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }

      // Update dari Masjid (2026-09-12) — a lean "admin dashboard"
      // substitute: `donations/{id}.submitterUid` is a new OPTIONAL field
      // (api/approve-masjid.js accepts it from the Sheet, same
      // "only stored if present" pattern every other optional field
      // there already uses) the founder can set when approving a
      // campaign that came from a known Ajukan Campaign Masjid
      // submission. No existing campaign has this set yet — it's
      // shovel-ready, not yet usable, until the founder starts passing
      // it through. Whoever's uid matches it can post short public
      // updates on their own campaign.
      match /updates/{updateId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.auth.uid == get(/databases/$(database)/documents/donations/$(id)).data.submitterUid;
        allow update, delete: if false;
      }
    }

    // One doc per Midtrans Snap transaction attempt, created by
    // api/create-midtrans-transaction.js and only ever updated by
    // api/midtrans-notify.js's webhook (both Admin SDK, bypasses this too)
    // — a client can read its own (to poll "did my payment go through?"
    // if that's ever built), never write.
    match /paymentTransactions/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Interim manual-transfer path (GoPay/Mandiri) while waiting on
    // Midtrans Production approval — same shape as paymentTransactions:
    // created by api/report-manual-payment.js, only ever confirmed by
    // api/confirm-manual-payment.js (the link the founder taps from the
    // Telegram notification after checking their own bank/GoPay app), both
    // Admin SDK. A client never marks its own report "confirmed" —
    // otherwise anyone could claim they paid and self-credit.
    match /manualPayments/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Doa & Aminkan — a public amin wall. Deliberately trusts a normal
    // client write here (unlike the donation flows, which route all writes
    // through admin-only endpoints) since there's no money/fraud stakes in
    // someone tapping "aminkan" or posting a doa — the worst case is a
    // low-effort annoyance, not a financial exploit. `create` still checks
    // ownership (uid must match the poster), a length cap, and that
    // aminCount starts at 0 (can't post with a fake head start); `update`
    // is scoped to only the aminCount field, so a client can bump the
    // counter (via toggleAmin's transaction) but can't rewrite someone
    // else's doa text or author.
    match /doas/{id} {
      allow read: if true;
      // Last clause is the actual spam rate limit (2026-09-03) — the doa
      // wall used to have no create-side limit at all, only the FCM
      // broadcast did. Reads users/{uid}.lastDoaPostAt as it stood
      // *before* this write (lib/doa.js's createDoa commits this create
      // together with that field's update in one atomic batch, so a
      // client can't skip the bookkeeping write and post again
      // immediately) and rejects a create that's less than 30s after it.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.aminCount == 0
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('lastDoaPostAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastDoaPostAt + duration.value(30, 's')
        );
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aminCount']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // One doc per user who has amin-ed this doa — existence (not
      // content) is what matters, so the client can cheaply check "did I
      // already amin this?" without reading everyone who has.
      match /amins/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ajukan Campaign Masjid (2026-09-12) — an in-app alternative to the
    // existing Google Form intake (still live, see CLAUDE.md's "Daftarkan
    // Masjid" note): a signed-in user submits, the founder reviews it
    // manually (via the daily digest folded into
    // check-campaign-deadlines.js, same as umrohLeads/supportRequests
    // below) and — if approved — replicates it into the real, proven
    // approve-masjid.js pipeline. Deliberately NOT auto-published: this is
    // a donation/fundraising surface, the same fraud/trust boundary that
    // keeps `donations` itself fully server-write-only above.
    match /campaignRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.namaMasjid is string
        && request.resource.data.namaMasjid.size() > 0
        && request.resource.data.namaMasjid.size() <= 200;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false; // status only ever moves via the founder's manual follow-up, not a client write
    }

    // Minat Umroh — a lead-gen form on the Umroh hub (2026-09-12), for the
    // founder to manually connect with a licensed travel agency later. No
    // agency partnership exists yet — this just captures real interest so
    // that conversation has actual demand data behind it.
    match /umrohLeads/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // In-app "Hubungi Kami" support requests (2026-09-12) — see
    // pages/Bantuan.jsx. Same manual-review shape as the two above: no
    // support ticketing system exists, the founder follows up directly
    // (phone/email/WA, whatever the submitter left).
    match /supportRequests/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Usulan Fitur — a public feature-request board (2026-09-12), same
    // "public read, narrow-validated create, single-field update" shape
    // `doas` already established above (no money/fraud stakes here
    // either — worst case is a low-effort annoyance, not an exploit).
    match /featureRequests/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.upvoteCount == 0
        && request.resource.data.status == 'baru';
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      // One doc per user who has upvoted this request — same existence-
      // only-matters shape as doas/{id}/amins/{uid}.
      match /upvotes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Grup Ibadah (2026-09-12) — small circles (family/pengajian) sharing
    // dzikir/reading-streak numbers. `groupInvites/{code}` is a tiny
    // public-read pointer (code → groupId) so someone can join a group
    // whose id they don't already know without needing list/query access
    // to the (member-only-readable) groups collection itself — the
    // group's own `update` rule below doesn't require prior read access,
    // it just validates the write itself, so joining works even though
    // reading the group before joining doesn't.
    match /groupInvites/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.groupId is string;
      allow update, delete: if false;
    }
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      // Two independent client-writable transitions, nothing else: (1)
      // joining — append exactly my own uid to memberUids, validated
      // without requiring the joiner to have read access to the doc
      // first (see groupInvites above); (2) the owner setting/clearing a
      // weekly challenge target (2026-09-12) — no validation on the
      // shape of `challenge` itself beyond "only the owner can touch it",
      // same low-stakes trust level as everything else in this
      // collection (no money involved).
      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && (request.auth.uid in request.resource.data.memberUids)
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challenge'])
          && request.auth.uid == resource.data.ownerUid
        )
      );
      allow delete: if false;

      // Each member self-reports their own current streak numbers here
      // (no live cross-user query needed) — readable by any group member,
      // writable only by the member it belongs to.
      match /memberStats/{uid} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Onboarding funnel telemetry (2026-09-12) — a single shared counter
    // doc, no per-user documents at all (there's nothing to read back
    // per-user, this is aggregate-only and the founder reads it via the
    // Firestore console). `hasOnly` against this exact, hand-maintained
    // key list is what keeps an authenticated client from writing
    // anything else into this doc — keep it in sync with
    // lib/onboardingFunnel.js's own STEP_KEYS if that ever changes.
    match /analytics/onboardingFunnel {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['step_0_view', 'step_1_view', 'step_2_view', 'step_3_view', 'step_4_view', 'step_5_view', 'completed', 'skipped']);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['step_0_view', 'step_1_view', 'step_2_view', 'step_3_view', 'step_4_view', 'step_5_view', 'completed', 'skipped']);
      allow delete: if false;
    }

    // Referral leaderboard (2026-09-12) — a small public snapshot
    // (top-10 {name, count}, no uid/email) computed once a day by
    // check-campaign-deadlines.js via the Admin SDK. Deliberately not a
    // live client query over `users` (that collection's own rule is
    // owner-read-only, and even if it weren't, exposing every user's
    // referralCount via an open query would leak more than a curated
    // top-10 snapshot needs to).
    match /leaderboards/referral {
      allow read: if true;
      allow write: if false;
    }

    // Yang Baru reactions (2026-09-12) — 👍/👎 per changelog version, same
    // public-read/count-doc-plus-existence-subcollection shape `doas`'
    // aminCount already established, done twice (independent, not
    // mutually exclusive — simpler than a single toggle that has to track
    // which way someone last voted).
    match /changelogReactions/{version} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['helpfulCount', 'notHelpfulCount']);
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'notHelpfulCount']);
      allow delete: if false;

      match /helpfulVotes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /notHelpfulVotes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Survei NPS super ringan (2026-09-12) — one doc per response, no
    // read-back needed by the client (the founder reads these via the
    // Firestore console), same "create-only, no client read" shape as
    // the feedback subcollection under users/{uid} but standalone since
    // an NPS score isn't tied to a specific ibadah feature.
    match /npsResponses/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10;
      allow read, update, delete: if false;
    }

    // Dampak airmoon public stats (2026-09-12) — see
    // pages/DampakAirmoon.jsx and check-campaign-deadlines.js's
    // checkPublicImpactStats. Public-read, same shape as the referral
    // leaderboard above.
    match /publicStats/impact {
      allow read: if true;
      allow write: if false;
    }

    // Survei churn super singkat (2026-09-12) — same create-only, no
    // client read-back shape as npsResponses above.
    match /churnSurveyResponses/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if false;
    }

    // Lightweight error log (2026-09-12) — see lib/errorLog.js's header
    // for what this is and isn't. Deliberately allows an unauthenticated
    // create (an error on Login/SignUp before sign-in is exactly the
    // kind of thing worth capturing) — low stakes even fully open
    // (Firestore write spam at worst, no money/PII exposure), so this
    // trades a little abuse surface for actually catching pre-auth
    // errors, same trade-off `doas` already made for a different reason.
    match /errorLogs/{id} {
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.source is string
        && request.resource.data.url is string;
      allow read, update, delete: if false;
    }

    // Kalkulator Zakat Korporat lead (2026-09-12) — same create-own,
    // no-read-back, founder-follows-up-manually shape as
    // campaignRequests/umrohLeads/supportRequests above.
    match /corporateZakatLeads/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 200
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0;
      allow read, update, delete: if false;
    }

    // Doa Bersama Terjadwal (2026-09-12) — a scheduled community-prayer
    // moment anyone can propose (same public-write trust level as `doas`
    // itself — no money, worst case a low-effort annoyance), others can
    // "Ikut" (join). `participantCount` follows the exact same
    // increment-on-toggle/existence-subcollection shape `doas.aminCount`
    // already established.
    match /doaBersama/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.scheduledFor is timestamp
        && request.resource.data.participantCount == 0;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      match /participants/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Reaksi jawaban Ust. Rewin (2026-09-12) — one doc per feedback tap,
    // no read-back needed (aggregate quality signal only, founder skims
    // via console) — same create-only shape as npsResponses.
    match /askMeFeedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.helpful is bool;
      allow read, update, delete: if false;
    }

    // Tanya Jawab Sesama Pengguna (2026-09-12) — a peer Q&A board,
    // distinct from AskMe's AI-only chat, no money/fraud stakes. Same
    // public-read/narrow-create/single-field-update shape `doas`/
    // `featureRequests` already established, except `update` now has TWO
    // independent single-field branches (`upvoteCount` for upvoting the
    // question, `answerCount` for anyone posting an answer to it — a
    // different action from upvoting, so it needs its own branch rather
    // than folding into the same hasOnly list). Neither branch validates
    // the new value is a real ±1 delta from the old one — same known,
    // accepted limitation `doas.aminCount`/`featureRequests.upvoteCount`
    // already carry.
    match /communityQuestions/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.upvoteCount == 0
        && request.resource.data.answerCount == 0;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;

      match /upvotes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /answers/{answerId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // Minat Jadi Relawan (2026-09-12) — same lead-gen shape as
    // umrohLeads/corporateZakatLeads above.
    match /volunteerLeads/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0;
      allow read, update, delete: if false;
    }

    // Everything else stays locked until it has a real data model.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
